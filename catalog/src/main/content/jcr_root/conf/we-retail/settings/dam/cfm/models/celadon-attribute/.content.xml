<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="cq:Template"
    allowedPaths="[/content/dam(/.*)?]"
    ranking="{Long}100">
    <jcr:content
        cq:scaffolding="/conf/we-retail/settings/dam/cfm/models/celadon-attribute/jcr:content/model"
        cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
        jcr:description="Per-attribute manifest entry"
        jcr:primaryType="cq:PageContent"
        jcr:title="Celadon Attribute"
        sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
        sling:resourceType="dam/cfm/models/console/components/data/entity/default"
        status="enabled">
        <metadata jcr:primaryType="nt:unstructured"/>
        <model
            cq:targetPath="/content/entities"
            jcr:primaryType="cq:PageContent"
            sling:resourceType="wcm/scaffolding/components/scaffolding"
            dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
            maxGeneratedOrder="{Long}9">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/authoring/dialog">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                    <items
                        jcr:primaryType="nt:unstructured"
                        maxGeneratedOrder="{Long}9">
                        <code
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            cfm-element="Code"
                            fieldLabel="Code"
                            listOrder="1"
                            metaType="text-single"
                            name="code"
                            renderReadOnly="false"
                            required="true"
                            showEmptyInReadOnly="true"
                            valueType="string"/>
                        <label
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            cfm-element="Label"
                            fieldLabel="Label"
                            listOrder="2"
                            metaType="text-single"
                            name="label"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            valueType="string"/>
                        <type
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            cfm-element="Type"
                            fieldLabel="Type"
                            listOrder="3"
                            metaType="text-single"
                            name="type"
                            renderReadOnly="false"
                            required="true"
                            showEmptyInReadOnly="true"
                            valueType="string"/>
                        <scope
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            cfm-element="Scope"
                            fieldLabel="Scope"
                            listOrder="4"
                            metaType="text-single"
                            name="scope"
                            renderReadOnly="false"
                            required="true"
                            showEmptyInReadOnly="true"
                            valueType="string"/>
                        <filterable
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                            cfm-element="Filterable"
                            fieldLabel="Filterable"
                            listOrder="5"
                            metaType="boolean"
                            name="filterable"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            text="Filterable"
                            valueType="boolean"/>
                        <aggregatable
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                            cfm-element="Aggregatable"
                            fieldLabel="Aggregatable"
                            listOrder="6"
                            metaType="boolean"
                            name="aggregatable"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            text="Aggregatable"
                            valueType="boolean"/>
                        <ordering
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                            cfm-element="Ordering"
                            fieldLabel="Ordering"
                            listOrder="7"
                            metaType="number"
                            name="ordering"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            typeHint="long"
                            valueType="long"/>
                        <optionDefinition
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/models/editor/components/fragmentreference"
                            cfm-element="Option Definition"
                            fieldLabel="Option Definition"
                            filter="hierarchy"
                            listOrder="8"
                            metaType="fragment-reference"
                            name="optionDefinition"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            valueType="string/content-fragment"/>
                        <sourceHint
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            cfm-element="Source Hint"
                            fieldLabel="Source Hint"
                            listOrder="9"
                            metaType="text-single"
                            name="sourceHint"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            valueType="string"/>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
