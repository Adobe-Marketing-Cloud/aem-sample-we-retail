<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="cq:Template"
    allowedPaths="[/content/dam(/.*)?]"
    ranking="{Long}100">
    <jcr:content
        cq:scaffolding="/conf/we-retail/settings/dam/cfm/models/product/jcr:content/model"
        cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
        jcr:description="Per-catalog product model generated from attribute manifest"
        jcr:primaryType="cq:PageContent"
        jcr:title="Product (we-retail)"
        sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
        sling:resourceType="dam/cfm/models/console/components/data/entity/default"
        status="enabled">
        <metadata jcr:primaryType="nt:unstructured"/>
        <model
            cq:targetPath="/content/entities"
            jcr:primaryType="cq:PageContent"
            sling:resourceType="wcm/scaffolding/components/scaffolding"
            dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
            maxGeneratedOrder="{Long}11">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/authoring/dialog">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                    <items
                        jcr:primaryType="nt:unstructured"
                        maxGeneratedOrder="{Long}14">
                        <image
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                            cfm-element="Image"
                            fieldLabel="Image"
                            filter="hierarchy"
                            listOrder="1"
                            metaType="reference"
                            name="image"
                            nameSuffix="contentReference"
                            renderReadOnly="false"
                            rootPath="/content/dam/celadon"
                            showEmptyInReadOnly="true"
                            valueType="string[]">
                            <field
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="dam/cfm/models/editor/components/contentreference"
                                filter="hierarchy"
                                name="image"
                                renderReadOnly="false"
                                rootPath="/content/dam/celadon"
                                showThumbnail="true"
                                validation="cfm.validation.contenttype.image">
                                <granite:data
                                    jcr:primaryType="nt:unstructured"
                                    showThumbnail="true"
                                    thumbnail-validation="cfm.validation.thumbnail.show"/>
                            </field>
                        </image>
                        <configurableOptions
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                            cfm-element="Configurable options"
                            fieldLabel="Configurable options"
                            listOrder="2"
                            metaType="text-single"
                            name="configurableOptions"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            valueType="string[]">
                            <field
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Option-definition path"
                                name="configurableOptions"
                                renderReadOnly="false"/>
                        </configurableOptions>
                        <additionalCategories
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                            cfm-element="Additional categories"
                            fieldLabel="Additional categories"
                            listOrder="3"
                            metaType="text-single"
                            name="additionalCategories"
                            renderReadOnly="false"
                            showEmptyInReadOnly="true"
                            valueType="string[]">
                            <field
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Category path"
                                name="additionalCategories"
                                renderReadOnly="false"/>
                        </additionalCategories>
                        <sku
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            cfm-element="SKU"
                            fieldLabel="SKU"
                            listOrder="4"
                            metaType="text-single"
                            name="sku"
                            renderReadOnly="false"
                            scope="both"
                            showEmptyInReadOnly="true"
                            valueType="string"/>
                        <name
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            cfm-element="Name"
                            fieldLabel="Name"
                            listOrder="5"
                            metaType="text-single"
                            name="name"
                            renderReadOnly="false"
                            scope="product"
                            showEmptyInReadOnly="true"
                            valueType="string"/>
                        <description
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                            cfm-element="Description"
                            fieldLabel="Description"
                            listOrder="6"
                            metaType="text-multi"
                            name="description"
                            renderReadOnly="false"
                            scope="product"
                            showEmptyInReadOnly="true"
                            valueType="string"/>
                        <price
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                            cfm-element="Price"
                            fieldLabel="Price"
                            listOrder="7"
                            metaType="number"
                            name="price"
                            renderReadOnly="false"
                            scope="both"
                            showEmptyInReadOnly="true"
                            step="any"
                            valueType="double"/>
                        <short_description
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                            cfm-element="Short Description"
                            fieldLabel="Short Description"
                            listOrder="8"
                            metaType="text-multi"
                            name="short_description"
                            renderReadOnly="false"
                            scope="product"
                            showEmptyInReadOnly="true"
                            valueType="string"/>
                        <identifier
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            cfm-element="identifier"
                            fieldLabel="identifier"
                            listOrder="9"
                            metaType="text-single"
                            name="identifier"
                            renderReadOnly="false"
                            scope="both"
                            showEmptyInReadOnly="true"
                            valueType="string"/>
                        <rating
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            cfm-element="rating"
                            fieldLabel="rating"
                            listOrder="10"
                            metaType="text-single"
                            name="rating"
                            renderReadOnly="false"
                            scope="product"
                            showEmptyInReadOnly="true"
                            valueType="string"/>
                        <features
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            cfm-element="features"
                            fieldLabel="features"
                            listOrder="11"
                            metaType="text-single"
                            name="features"
                            renderReadOnly="false"
                            scope="product"
                            showEmptyInReadOnly="true"
                            valueType="string"/>
                        <reviews
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            cfm-element="reviews"
                            fieldLabel="reviews"
                            listOrder="12"
                            metaType="text-single"
                            name="reviews"
                            renderReadOnly="false"
                            scope="product"
                            showEmptyInReadOnly="true"
                            valueType="string"/>
                        <size
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            cfm-element="size"
                            fieldLabel="size"
                            listOrder="13"
                            metaType="text-single"
                            name="size"
                            renderReadOnly="false"
                            scope="both"
                            showEmptyInReadOnly="true"
                            valueType="string"/>
                        <color
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            cfm-element="color"
                            fieldLabel="color"
                            listOrder="14"
                            metaType="text-single"
                            name="color"
                            renderReadOnly="false"
                            scope="variant"
                            showEmptyInReadOnly="true"
                            valueType="string"/>
                    </items>
                </content>
            </cq:dialog>
            <variations jcr:primaryType="nt:unstructured">
                <cq:dialog
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="cq/gui/components/authoring/dialog">
                    <content
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                        <items
                            jcr:primaryType="nt:unstructured"
                            maxGeneratedOrder="{Long}6">
                            <image
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                cfm-element="Image"
                                fieldLabel="Image"
                                filter="hierarchy"
                                listOrder="1"
                                metaType="reference"
                                name="image"
                                nameSuffix="contentReference"
                                renderReadOnly="false"
                                rootPath="/content/dam/celadon"
                                showEmptyInReadOnly="true"
                                valueType="string[]">
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="dam/cfm/models/editor/components/contentreference"
                                    filter="hierarchy"
                                    name="image"
                                    renderReadOnly="false"
                                    rootPath="/content/dam/celadon"
                                    showThumbnail="true"
                                    validation="cfm.validation.contenttype.image">
                                    <granite:data
                                        jcr:primaryType="nt:unstructured"
                                        showThumbnail="true"
                                        thumbnail-validation="cfm.validation.thumbnail.show"/>
                                </field>
                            </image>
                            <sku
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                cfm-element="SKU"
                                fieldLabel="SKU"
                                listOrder="2"
                                metaType="text-single"
                                name="sku"
                                renderReadOnly="false"
                                scope="both"
                                showEmptyInReadOnly="true"
                                valueType="string"/>
                            <price
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                cfm-element="Price"
                                fieldLabel="Price"
                                listOrder="3"
                                metaType="number"
                                name="price"
                                renderReadOnly="false"
                                scope="both"
                                showEmptyInReadOnly="true"
                                step="any"
                                valueType="double"/>
                            <identifier
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                cfm-element="identifier"
                                fieldLabel="identifier"
                                listOrder="4"
                                metaType="text-single"
                                name="identifier"
                                renderReadOnly="false"
                                scope="both"
                                showEmptyInReadOnly="true"
                                valueType="string"/>
                            <size
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                cfm-element="size"
                                fieldLabel="size"
                                listOrder="5"
                                metaType="text-single"
                                name="size"
                                renderReadOnly="false"
                                scope="both"
                                showEmptyInReadOnly="true"
                                valueType="string"/>
                            <color
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                cfm-element="color"
                                fieldLabel="color"
                                listOrder="6"
                                metaType="text-single"
                                name="color"
                                renderReadOnly="false"
                                scope="variant"
                                showEmptyInReadOnly="true"
                                valueType="string"/>
                        </items>
                    </content>
                </cq:dialog>
            </variations>
        </model>
    </jcr:content>
</jcr:root>
